class ListNode:
    def __init__(self, data):
        self.data = data
        self.prev = None
        self.next = None

class Solution:
    def reverseDLL(self, head):
        n=head
        while n.next is not None:
            n.next,n.prev=n.prev,n.next
            n=n.prev
        
        n.next,n.prev=n.prev,n.next
        head=n
        return head
