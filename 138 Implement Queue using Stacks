class MyQueue:

    def __init__(self):
        self.s1Queue=[]
        self.s2Queue=[]

    def push(self, x: int) -> None:
        while len(self.s1Queue):
            self.s2Queue.append(self.s1Queue[-1])
            self.s1Queue.pop()
        self.s1Queue.append(x)
        while len(self.s2Queue):
            self.s1Queue.append(self.s2Queue[-1])
            self.s2Queue.pop()
        
    
    def pop(self) -> int:
        return self.s1Queue.pop()
        

    def peek(self) -> int:
        return self.s1Queue[-1]
        

    def empty(self) -> bool:
        return len(self.s1Queue)==0
        


