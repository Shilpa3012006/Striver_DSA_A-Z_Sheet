
# Definition for a Node.
class ListNode:
    def __init__(self, data, prev=None, next=None):
        self.data = data
        self.prev = prev
        self.next = next


class Solution:
    def insertBeforeHead(self, head: ListNode, X: int) -> ListNode:
        new_node=ListNode(X)
        if head is None:
            return new_node
        else:
            
            new_node.next=head
            head.prev=new_node
            head=new_node
            return head
