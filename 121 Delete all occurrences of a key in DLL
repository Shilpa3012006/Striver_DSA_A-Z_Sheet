# Definition of doubly linked list:
# class ListNode:
#     def __init__(self, val=0, next=None, prev=None):
#         self.val = val
#         self.next = next
#         self.prev = prev

class Solution:
    def deleteAllOccurrences(self, head, target):
        if head is None:
            return head

        # Delete all matching head nodes
        while head is not None and head.val == target:
            head = head.next
            if head is not None:
                head.prev = None

        if head is None:
            return head

        temp = head

        while temp.next:
            if temp.next.val == target:
                temp.next = temp.next.next
                if temp.next is not None:
                    temp.next.prev = temp
            else:
                temp = temp.next

        if temp.val == target:
            temp.prev.next = None

        return head
